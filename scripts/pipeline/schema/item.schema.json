{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryzm.app/scripts/pipeline/schema/item.schema.json",
  "title": "RYZM node file (data/nodes/<node>.json or data/pipeline/claims/<node>.json)",
  "type": "object",
  "required": ["node_id", "items"],
  "properties": {
    "node_id": {"enum": ["rates_funding", "global_credit_macro", "asia_early_signal", "crypto_leverage"]},
    "generated_at": {"type": "string"},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["node_id", "asset_or_theme", "metric_value", "delta", "priced_in_score",
                   "momentum_score", "tension_score", "claim", "source_url", "published_at"],
      "properties": {
        "node_id": {"enum": ["rates_funding", "global_credit_macro", "asia_early_signal", "crypto_leverage"]},
        "asset_or_theme": {"type": "string", "minLength": 2, "maxLength": 60},
        "metric_value": {"type": ["number", "string", "null"]},
        "delta": {"type": ["number", "string", "null"]},
        "priced_in_score": {"type": "number", "minimum": 0, "maximum": 100},
        "momentum_score": {"type": "number", "minimum": -50, "maximum": 50},
        "tension_score": {"type": "number", "minimum": 0, "maximum": 100},
        "claim": {"type": "string", "minLength": 8, "maxLength": 400},
        "source_url": {"type": "string", "pattern": "^https://"},
        "published_at": {"type": "string", "description": "ISO 8601 date or date-time"}
      },
      "additionalProperties": true
    }
  }
}
